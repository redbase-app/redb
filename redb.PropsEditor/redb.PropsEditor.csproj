<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RepositoryUrl>https://github.com/redbase-app/redb</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" />
    <!-- Версия точная, а не плавающая 4.*, и совпадает с redb.Doc.Web и redb.Lk.
         С плавающей библиотека собиралась под свежую 4.x, а в образ приложения
         клалась 4.13.2 из его собственной ссылки: PropsGrid падал при отрисовке
         с FileNotFoundException, и весь раздел /admin/props отдавал 500.
         Компилятор такое не ловит, поломка выстреливала сама при выходе новой
         4.x, без единой правки в репозитории. -->
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.13.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="redb.Core" Version="$(Version)" />
  </ItemGroup>

</Project>
