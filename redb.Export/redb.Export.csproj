<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>redb.Export</PackageId>
    <Product>REDB - Entity Database for .NET</Product>
    <Description>Database export/import library for REDB. Supports PostgreSQL and MS SQL Server. Streams schema and data as JSONL (optionally compressed) for backup, migration, and replication scenarios.</Description>
    <RepositoryUrl>https://github.com/redbase-app/redb</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>redb;export;import;database;postgres;mssql;migration;backup</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Same pin as redb.SQLite, and for the same reason: Microsoft.Data.Sqlite drags in
         SQLitePCLRaw through bundle/provider, and the version it picks is flagged by
         NU1903 / GHSA-2m69-gcr7-jv3q (high). redb.SQLite pinned the native lib long ago;
         redb.Export was left on Microsoft.Data.Sqlite 9.0.3 and kept resolving the
         vulnerable e_sqlite3 2.1.10 into a PUBLISHED package. Do not remove the pin —
         without it the transitive resolution falls straight back to the flagged version. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

</Project>
