<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>redb.Templates</PackageId>
    <Title>RedBase Project Templates</Title>
    <Authors>RedBase</Authors>
    <Company>RedBase</Company>
    <Description>Project templates for RedBase (REDB), the entity database for .NET: a console app (dotnet new redb), a Razor Pages site (redb-razor), a Blazor site (redb-blazor), an integration worker (redb-worker), an LLM chat (redb-chat), a Blazor WebAssembly app with a redb.Route API (redb-app) and a Blazor BFF with redb.Route controllers (redb-bff). Each runs as is on SQLite with Pro; the route-based ones also deploy as Tsak modules.</Description>
    <PackageTags>dotnet-new;templates;redbase;redb;database;entity;tree;linq;blazor;razor;worker;llm;bff;tsak</PackageTags>
    <PackageProjectUrl>https://redbase.app</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/redbase-app/redb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2024-2026 RedBase</Copyright>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**" />
    <Compile Remove="**\*" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>