<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RedbApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

  <!--#if (UsePostgres && pro) -->
  <ItemGroup>
    <PackageReference Include="redb.Postgres.Pro" Version="3.7.2" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (UsePostgres && !pro) -->
  <ItemGroup>
    <PackageReference Include="redb.Postgres" Version="3.7.2" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (UseMsSql && pro) -->
  <ItemGroup>
    <PackageReference Include="redb.MSSql.Pro" Version="3.7.2" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (UseMsSql && !pro) -->
  <ItemGroup>
    <PackageReference Include="redb.MSSql" Version="3.7.2" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (UseSqlite && pro) -->
  <ItemGroup>
    <PackageReference Include="redb.SQLite.Pro" Version="3.7.2" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (UseSqlite && !pro) -->
  <ItemGroup>
    <PackageReference Include="redb.SQLite" Version="3.7.2" />
  </ItemGroup>
  <!--#endif -->

</Project>
