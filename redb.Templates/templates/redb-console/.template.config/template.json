{
  "$schema": "http://json.schemastore.org/template",
  "author": "RedBase",
  "classifications": [ "Console", "Database", "RedBase" ],
  "identity": "RedBase.Console.Template",
  "name": "RedBase Console Application",
  "description": "A console application on redb: objects with typed props created, queried, aggregated and arranged in a tree, in SQLite, PostgreSQL or SQL Server.",
  "shortName": "redb",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "RedbApp",
  "preferNameDirectory": true,
  "symbols": {
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "sqlite",
      "displayName": "Database",
      "description": "Database provider to use",
      "choices": [
        { "choice": "postgres", "description": "PostgreSQL (via Npgsql)" },
        { "choice": "mssql", "description": "Microsoft SQL Server" },
        { "choice": "sqlite", "description": "SQLite (embedded; Pro runs in Blazor WASM / mobile)" }
      ]
    },
    "pro": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Pro features",
      "description": "Include Pro features (LINQ compilation, change tracking, analytics)"
    },
    "UsePostgres": {
      "type": "computed",
      "value": "(db == \"postgres\")"
    },
    "UseMsSql": {
      "type": "computed",
      "value": "(db == \"mssql\")"
    },
    "UseSqlite": {
      "type": "computed",
      "value": "(db == \"sqlite\")"
    }
  },
  "sources": [
    {
      "modifiers": []
    }
  ]
}
