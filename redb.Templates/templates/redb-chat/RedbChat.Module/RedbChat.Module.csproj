<Project Sdk="Microsoft.NET.Sdk">

  <!-- The module: InitRoute.main and the chat routes. The same DLL runs in two places: RedbChat.Host
       calls InitRoute.main itself, and a Tsak worker loads it from RedbChat.tpkg
       (deploy/pack-tpkg.ps1). redb and the redb.Route packages below ship with the Tsak worker, so the
       package carries only this DLL. -->

  <ItemGroup>
    <PackageReference Include="redb.Core" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route.Core" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route.Http" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route.Llm" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route.Llm.Abstractions" Version="$(RedbVersion)" />
<!--#if (UseShell) -->
    <PackageReference Include="redb.Route.Exec" Version="$(RedbVersion)" />
<!--#endif -->
<!--#if (UseMcp) -->
    <PackageReference Include="redb.Route.Llm.Mcp" Version="$(RedbVersion)" />
<!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!-- The module's configuration. Packed into the .tpkg; copied to the output so the host reads the
         same file the Tsak worker does. -->
    <None Update="RedbChat.Module.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
