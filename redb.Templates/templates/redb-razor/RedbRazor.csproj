<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RedbRazor</RootNamespace>
    <!-- One place for the RedBase version used by this project. -->
    <RedbVersion>4.4.0</RedbVersion>
    <!-- Versions live in these files: the project is created where no central Directory.Packages.props applies. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite with Pro: the database is a file next to the app, nothing to install.
         For PostgreSQL or SQL Server replace it with redb.Postgres.Pro or redb.MSSql.Pro
         and follow the comment in Program.cs. -->
    <PackageReference Include="redb.SQLite.Pro" Version="$(RedbVersion)" />
  </ItemGroup>

</Project>
