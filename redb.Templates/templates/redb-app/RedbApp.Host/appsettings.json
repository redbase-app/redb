{
  "ConnectionStrings": {
    "Redb": "Data Source=redbapp.db"
  },
  "Tsak": {
    "Contexts": {
      "redbapp": {
        // The Override layer of the API's settings: it wins over RedbApp.Api.config.json. The same keys
        // work on a Tsak worker as environment variables, for example
        // Tsak__Contexts__redbapp__Override__Auth__SigningKey.
        "Override": {
          "Auth": {
            // Signs the sign-in tokens, at least 32 characters. This one is for your machine only:
            // set your own through the environment everywhere else.
            "SigningKey": "local-development-key-change-me-0123456789",

            // Who can sign in. A stand-in that keeps the template small: a real application keeps its
            // users in a store of its own, for example redb.Identity.
            "Users": {
              "admin": { "Password": "admin", "Role": "admin" }
            }
          }
        }
      }
    }
  }
}
