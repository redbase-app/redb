<Project Sdk="Microsoft.NET.Sdk">

  <!-- The API: a module with InitRoute.main and the REST routes. The same DLL runs in two places:
       RedbApp.Host calls InitRoute.main itself, and a Tsak worker loads it from RedbApp.tpkg
       (deploy/pack-tpkg.ps1). redb, redb.Route and Microsoft.IdentityModel ship with the Tsak worker,
       so the package carries this DLL and RedbApp.Models.dll. -->

  <ItemGroup>
    <ProjectReference Include="..\RedbApp.Models\RedbApp.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="redb.Core" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route.Core" Version="$(RedbVersion)" />
    <PackageReference Include="redb.Route.Http" Version="$(RedbVersion)" />
    <!-- Issues and checks the sign-in tokens. The version the Tsak worker ships. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's configuration. Packed into the .tpkg; copied to the output so the host reads the
         same file the Tsak worker does. -->
    <None Update="RedbApp.Api.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
