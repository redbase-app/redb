# The docker-compose files in this folder read these. Copy this file to deploy/.env and fill them in.

# Signs the sign-in tokens of the API, at least 32 characters.
APP_SIGNING_KEY=
# Password of the admin user of the application.
APP_ADMIN_PASSWORD=

# Only docker-compose.tsak.yml reads the four values below.

# HMAC secret of the worker's API keys, at least 16 characters.
TSAK_AUTH_SECRET=
# The dashboard's service key: any random string. The worker stores only its hash.
TSAK_WEB_API_KEY=
# HMAC-SHA256(TSAK_WEB_API_KEY, key = TSAK_AUTH_SECRET), hex, upper case:
#   printf %s "$TSAK_WEB_API_KEY" | openssl dgst -sha256 -hmac "$TSAK_AUTH_SECRET" | awk '{print toupper($NF)}'
#   PowerShell: [Convert]::ToHexString([Security.Cryptography.HMACSHA256]::new([Text.Encoding]::UTF8.GetBytes($secret)).ComputeHash([Text.Encoding]::UTF8.GetBytes($key)))
TSAK_WEB_API_KEY_HASH=
# Password of the dashboard's admin login.
TSAK_WEB_ADMIN_PASSWORD=
