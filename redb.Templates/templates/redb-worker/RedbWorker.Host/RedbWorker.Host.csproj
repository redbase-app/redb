<Project Sdk="Microsoft.NET.Sdk">

  <!-- The module's own host: a console process that runs the module without Tsak. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedbWorker.Module\RedbWorker.Module.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite with Pro: the database is a file, nothing to install. For PostgreSQL or SQL Server
         replace it with redb.Postgres.Pro or redb.MSSql.Pro and follow the comment in Program.cs. -->
    <PackageReference Include="redb.SQLite.Pro" Version="$(RedbVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
