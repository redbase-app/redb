{
  "$schema": "http://json.schemastore.org/template",
  "author": "RedBase",
  "classifications": [ "Worker", "Integration", "Database", "RedBase" ],
  "identity": "RedBase.Worker.Template",
  "name": "RedBase Integration Worker",
  "description": "An integration worker on redb.Route and redb: a folder inbox, an XSD check, one transaction and a receipt; its own host or a Tsak module.",
  "shortName": "redb-worker",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "RedbWorker",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**", "**/[Oo]bj/**", ".template.config/**/*", "**/*.filelist", "**/*.user", "**/*.lock.json",
        "**/*.db", "**/*.db-shm", "**/*.db-wal", "data/**", "runtime/**", "deploy/output/**", "deploy/.env"
      ]
    }
  ]
}
