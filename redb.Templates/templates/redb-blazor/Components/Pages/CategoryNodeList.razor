@* Renders a level of the tree and calls itself for the children. *@

<ul class="tree">
    @foreach (var node in Nodes)
    {
        <li>
            <span>@node.Name</span>
            <button class="link" @onclick="() => adding = node.Id">Add child</button>
            <button class="link" @onclick="() => OnDelete.InvokeAsync(node)">Delete</button>

            @if (adding == node.Id)
            {
                <span class="inline">
                    <input placeholder="Child name" @bind="childName" />
                    <button disabled="@string.IsNullOrWhiteSpace(childName)" @onclick="() => AddAsync(node)">Add</button>
                    <button class="link" @onclick="Cancel">Cancel</button>
                </span>
            }

            @if (node.Children.Any())
            {
                <CategoryNodeList Nodes="node.Children" OnAddChild="OnAddChild" OnDelete="OnDelete" />
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IEnumerable<ITreeRedbObject> Nodes { get; set; } = [];
    [Parameter] public EventCallback<(ITreeRedbObject Parent, string Name)> OnAddChild { get; set; }
    [Parameter] public EventCallback<ITreeRedbObject> OnDelete { get; set; }

    private long? adding;
    private string? childName;

    private async Task AddAsync(ITreeRedbObject parent)
    {
        var name = childName!.Trim();
        Cancel();
        await OnAddChild.InvokeAsync((parent, name));
    }

    private void Cancel()
    {
        adding = null;
        childName = null;
    }
}
