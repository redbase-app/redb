# The docker-compose files in this folder read these. Copy this file to deploy/.env and fill them in.
# Every secret: at least 32 random characters, e.g.  openssl rand -base64 33

# Password of the Tsak dashboard (login admin, http://localhost:8085).
TSAK_WEB_ADMIN_PASSWORD=
# Password of Identity's first administrator (login admin). Applied while admin still has the default.
IDENTITY_ADMIN_PASSWORD=
# Identity's service client (SeedBackchannelClient): the module sets itself up and reads the management
# API with it, and so does Identity's own UI.
MANAGEMENT_CLIENT_SECRET=
# The module's resource client: it introspects the access tokens sent to the API.
RESOURCE_CLIENT_SECRET=
#if (web)
# The web server's client. A web server started on the host (dotnet run, Development) uses the value of
# RedbIdentityApp.Web/appsettings.Development.json: keep the two equal on your machine, or set
# Identity__ClientSecret for it.
WEB_CLIENT_SECRET=local-development-web-client-secret-change-me
#endif
