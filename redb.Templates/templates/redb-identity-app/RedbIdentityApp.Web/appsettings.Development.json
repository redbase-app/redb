{
  "Identity": {
    // For your machine only, the same value as WEB_CLIENT_SECRET in deploy/.env.example. Everywhere else the
    // secret comes from the environment (Identity__ClientSecret) and this file is not deployed.
    "ClientSecret": "local-development-web-client-secret-change-me",
    // The redb-identity-full image serves a self-signed certificate for localhost. On your machine this
    // server accepts it; in any other environment the setting is refused at start (Auth/WebIdentityOptions.cs).
    "AcceptAnyServerCertificate": true
  }
}
