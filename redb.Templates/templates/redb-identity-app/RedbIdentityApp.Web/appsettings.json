{
  "Identity": {
    // redb.Identity's issuer: the redb-identity-full image of deploy/docker-compose.yml answers here.
    "Authority": "https://localhost:5002",
    // This server's client and the module's scopes: the same names as in
    // RedbIdentityApp.Module/RedbIdentityApp.Module.config.json, where the module creates them at Identity.
    "ClientId": "redbidentityapp-web",
    "ApiScope": "redbidentityapp.api",
    "AdminScope": "redbidentityapp.admin"
    // ClientSecret: never here. Identity__ClientSecret in the environment, the same value as
    // WEB_CLIENT_SECRET in deploy/.env.
  },
  "Module": {
    // The module's API inside the Tsak worker.
    "BaseUrl": "http://127.0.0.1:5094/"
  },
  "Web": {
    // Where the DataProtection key ring is kept; empty: the default folder of the user. A container sets
    // a volume here (deploy/docker-compose.yml).
    "DataProtectionKeysPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
