{
  "Backend": {
    "BaseUrl": "http://127.0.0.1:5093/",
    // Sent to the backend as a bearer token; the same value as Api:ServiceKey in
    // RedbBff.Host/appsettings.json. For your machine only: set your own through the environment
    // (Backend__ServiceKey) everywhere else.
    "ServiceKey": "local-development-service-key-change-me"
  },
  "Web": {
    // Who can sign in. A stand-in that keeps the template small: a real application keeps its users in a
    // store of its own, for example redb.Identity.
    "Users": {
      "admin": { "Password": "admin", "Role": "admin" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
