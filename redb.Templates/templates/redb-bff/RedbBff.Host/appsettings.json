{
  "ConnectionStrings": {
    "Redb": "Data Source=redbbff.db"
  },
  "Tsak": {
    "Contexts": {
      "redbbff": {
        // The Override layer of the backend's settings: it wins over RedbBff.Backend.config.json. The same
        // keys work on a Tsak worker as environment variables, for example
        // Tsak__Contexts__redbbff__Override__Api__ServiceKey.
        "Override": {
          "Api": {
            // The key the web server sends, at least 32 characters. It must match Backend:ServiceKey in
            // RedbBff.Web/appsettings.json. This one is for your machine only: set your own through the
            // environment everywhere else.
            "ServiceKey": "local-development-service-key-change-me"
          }
        }
      }
    }
  }
}
