<?xml version="1.0" encoding="utf-8"?>
<!-- Context-level document: loaded before the route files, so the routes can use its beans. -->
<context xmlns="urn:redb:route:1.0">

  <!-- One connection for every rabbitmq:// endpoint of the module: the URIs say
       connectionFactory=rabbit and carry no host or credentials of their own.
       The values come from the context configuration; the password has no default,
       so the module does not start until the deployment supplies it. -->
  <bean name="rabbit" type="redb.Route.RabbitMQ.RabbitMQConnectionFactory, redb.Route.RabbitMQ">
    <property key="Host" value="{{rabbit.host:localhost}}"/>
    <property key="Port" value="{{rabbit.port:5672}}"/>
    <property key="VirtualHost" value="{{rabbit.vhost:/}}"/>
    <property key="Username" value="{{rabbit.username:guest}}"/>
    <property key="Password" value="{{rabbit.password}}"/>
  </bean>

  <!-- Routes written in C#: routes/QuoteRpcRoute.cs, request-reply on the queue cs-quotes over the same connection. -->
  <routeBuilder type="RouteModule.Routes.QuoteRpcRoute, RouteModule"/>

</context>
