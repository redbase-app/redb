<?xml version="1.0" encoding="utf-8"?>
<!-- Context-level document: loaded before the route files, so the routes can use its beans,
     and its onInit runs before any route starts. -->
<context xmlns="urn:redb:route:1.0">

  <!-- The database of the module. ProviderName picks the driver the worker registered:
       Microsoft.Data.Sqlite, Npgsql or Microsoft.Data.SqlClient. To switch, change ProviderName,
       the connection string in the configuration and the CREATE TABLE below. -->
  <bean name="main-db" type="redb.Route.Sql.Connection.SqlConnectionFactory, redb.Route.Sql">
    <constructorArg>
      <bean type="redb.Route.Sql.Connection.SqlConnectionOptions, redb.Route.Sql">
<!--#if (db == "sqlite") -->
        <property key="ProviderName" value="Microsoft.Data.Sqlite"/>
        <property key="ConnectionString" value="{{db.connection:Data Source=modulectx.db}}"/>
<!--#elseif (db == "postgres") -->
        <property key="ProviderName" value="Npgsql"/>
        <property key="ConnectionString" value="{{db.connection}}"/>
<!--#else -->
        <property key="ProviderName" value="Microsoft.Data.SqlClient"/>
        <property key="ConnectionString" value="{{db.connection}}"/>
<!--#endif -->
      </bean>
    </constructorArg>
  </bean>

  <!-- Routes written in C#: routes/OrdersBatchRoute.cs writes batches of typed orders through the same bean. -->
  <routeBuilder type="RouteModule.Routes.OrdersBatchRoute, RouteModule"/>

  <!-- The table, created once before the routes start. CHECK (amount >= 0) is there to show what a
       batch does with a row the database refuses. -->
  <onInit>
<!--#if (db == "sqlite") -->
    <to uri="sql:CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, order_id TEXT NOT NULL, amount INTEGER NOT NULL CHECK (amount &gt;= 0))?dataSource=#main-db"/>
<!--#elseif (db == "postgres") -->
    <to uri="sql:CREATE TABLE IF NOT EXISTS orders (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, order_id TEXT NOT NULL, amount BIGINT NOT NULL CHECK (amount &gt;= 0))?dataSource=#main-db"/>
<!--#else -->
    <to uri="sql:IF OBJECT_ID('orders') IS NULL CREATE TABLE orders (id BIGINT IDENTITY(1,1) PRIMARY KEY, order_id NVARCHAR(100) NOT NULL, amount BIGINT NOT NULL CHECK (amount &gt;= 0))?dataSource=#main-db"/>
<!--#endif -->
  </onInit>

</context>
