<?xml version="1.0" encoding="utf-8"?>
<!-- Context-level document: loaded before the route files, so the routes can use its beans. -->
<context xmlns="urn:redb:route:1.0">

  <!-- One AMQP 1.0 connection for every amqp:// endpoint of the module: the URIs say connectionFactory=amqp and carry
       no host or credentials. The password has no default, so the module does not start until the deployment supplies
       it. TLS: Ssl (port 5671) with SslCertPath for a client certificate. -->
  <bean name="amqp" type="redb.Route.Amqp.AmqpConnectionFactory, redb.Route.Amqp">
    <property key="Host" value="{{amqp.host:localhost}}"/>
    <property key="Port" value="{{amqp.port:5672}}"/>
    <property key="User" value="{{amqp.user}}"/>
    <property key="Password" value="{{amqp.password}}"/>
  </bean>

  <!-- Routes written in C#: routes/QuoteRpcRoute.cs, request-reply on the queue cs.quotes over the same connection. -->
  <routeBuilder type="RouteModule.Routes.QuoteRpcRoute, RouteModule"/>

</context>
