<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, the RedBase version and the build-time packaging live in
       Directory.Build.props and Directory.Build.targets next to this file. -->
  <PropertyGroup>
    <!-- The package name redb-route-xml pack uses: pkg/routemodule-<version>.tpkg,
         with config/routemodule.config.json as the in-package identity. -->
    <RoutePackageName>routemodule</RoutePackageName>
    <!-- The props classes of Props/ live in this assembly: the package carries it, so the worker finds
         type="RouteModule.Props.OrderProps, RouteModule". -->
    <RoutePackageIncludeAssembly>true</RoutePackageIncludeAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="redb.Route.Xml" Version="$(RedbVersion)" />
    <!-- The redb bridge: <redb>, <syncScheme>, <redbSave>, <redbQuery>, <redbGet>, <redbDelete>. -->
    <PackageReference Include="redb.Route.Core" Version="$(RedbVersion)" />
    <!-- [RedbScheme] for the props classes. The worker ships redb and its providers (Free and Pro);
         the module never carries them. -->
    <PackageReference Include="redb.Core" Version="$(RedbVersion)" />
  </ItemGroup>

</Project>
