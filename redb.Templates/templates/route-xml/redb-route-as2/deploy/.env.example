# Copy as deploy/.env (next to docker-compose.openas2.yml). Test values for the local stand only.

# The password of the module's test key pair (deploy/keys/module.p12): the certs service sets it, the worker opens
# the key with it. Changing it later: delete deploy/keys and deploy/openas2/config, then up again.
AS2_KEY_PASSWORD=

# The Tsak worker image tag.
# TSAK_VERSION=4.5.1-net10
