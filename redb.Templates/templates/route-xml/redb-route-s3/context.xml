<?xml version="1.0" encoding="utf-8"?>
<!-- Context-level document: loaded before the route files, so the routes can use its beans. -->
<context xmlns="urn:redb:route:1.0">

  <!-- One S3 connection for every s3:// endpoint of the module: the URIs say connectionFactory=s3 and carry no
       credentials. ServiceUrl and ForcePathStyle are for MinIO and other S3-compatible stores; for AWS leave
       ServiceUrl empty, set Region and ForcePathStyle false. The secret key has no default, so the module does not
       start until the deployment supplies it. -->
  <bean name="s3" type="redb.Route.S3.S3ConnectionFactory, redb.Route.S3">
    <property key="ServiceUrl" value="{{s3.serviceUrl:http://localhost:9000}}"/>
    <property key="Region" value="{{s3.region:us-east-1}}"/>
    <property key="ForcePathStyle" value="{{s3.forcePathStyle:true}}"/>
    <property key="AccessKey" value="{{s3.accessKey}}"/>
    <property key="SecretKey" value="{{s3.secretKey}}"/>
  </bean>

  <!-- Routes written in C#: routes/PriceListRoute.cs, price lists under prices/ over the same connection. -->
  <routeBuilder type="RouteModule.Routes.PriceListRoute, RouteModule"/>

</context>
