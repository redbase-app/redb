<?xml version="1.0" encoding="utf-8"?>
<!-- Context-level document: loaded before the route files, so the routes can use its beans. -->
<context xmlns="urn:redb:route:1.0">

  <!-- One broker for every mqtt:// endpoint of the module: the URIs say connectionFactory=mqtt and carry no host or
       credentials. The password has no default, so the module does not start until the deployment supplies it. No
       ClientId here: every endpoint opens its own connection, and two connections with one client id would push each
       other off the broker. TLS: UseTls (port 8883). -->
  <bean name="mqtt" type="redb.Route.MqttNet.MqttConnectionFactory, redb.Route.MqttNet">
    <property key="Server" value="{{mqtt.host:localhost}}"/>
    <property key="Port" value="{{mqtt.port:1883}}"/>
    <property key="Username" value="{{mqtt.username}}"/>
    <property key="Password" value="{{mqtt.password}}"/>
  </bean>

  <!-- Routes written in C#: routes/HumidityRoute.cs, humidity sensors on topics of their own over the same connection. -->
  <routeBuilder type="RouteModule.Routes.HumidityRoute, RouteModule"/>

</context>
