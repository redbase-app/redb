# Test entries for the local stand, loaded by OpenLDAP at its first start. Not real people, not real passwords.
dn: ou=users,dc=example,dc=org
objectClass: organizationalUnit
ou: users

dn: uid=alice,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: alice
cn: Alice Example
sn: Example
mail: alice@example.org
userPassword: alice-test-only

dn: uid=bob,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: bob
cn: Bob Example
sn: Example
mail: bob@example.org
userPassword: bob-test-only
