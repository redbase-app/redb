<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, the RedBase version and the build-time packaging live in
       Directory.Build.props and Directory.Build.targets next to this file. -->
  <PropertyGroup>
    <!-- The package name redb-route-xml pack uses: pkg/routemodule-<version>.tpkg,
         with config/routemodule.config.json as the in-package identity. -->
    <RoutePackageName>routemodule</RoutePackageName>
    <!-- The C# route of routes/OrdersRoute.cs lives in this assembly: the package carries it. -->
    <RoutePackageIncludeAssembly>true</RoutePackageIncludeAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="redb.Route.Xml" Version="$(RedbVersion)" />
    <!-- The <rest> element and the http:// connector. -->
    <PackageReference Include="redb.Route.Http" Version="$(RedbVersion)" />
    <!-- The xmljson data format of <dataFormat> in context.xml and MarshalXmlJson in C#. -->
    <PackageReference Include="redb.Route.DataFormats.XmlJson" Version="$(RedbVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# route reads the same schema, compiled in under its file name. -->
    <EmbeddedResource Include="resources/order.xsd" LogicalName="order.xsd" />
  </ItemGroup>

</Project>
