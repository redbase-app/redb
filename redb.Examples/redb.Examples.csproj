<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>redb.Examples.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local projects instead of NuGet packages: the PVT planner work is checked here against the sources. -->
    <PackageReference Include="redb.Core.Pro" Version="4.3.0" />
    <PackageReference Include="redb.Postgres.Pro" Version="4.3.0" />
    <PackageReference Include="redb.MSSql.Pro" Version="4.3.0" />
    <PackageReference Include="redb.SQLite.Pro" Version="4.3.0" />
  </ItemGroup>

</Project>
