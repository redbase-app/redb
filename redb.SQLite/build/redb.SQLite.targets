<Project>
  <!-- ===================================================================
       redb.SQLite (Free) - native SQLite loadable extension delivery.
       The Free tier hosts its server-side SQL functions (get_object_json,
       pvt_build_*_sql, soft-delete, permissions) as a native SQLite
       loadable extension: redbsqlite.dll (Windows) / redbsqlite.so (Linux) /
       redbsqlite.dylib (macOS). SQLite loads it by an explicit file path
       (conn.LoadExtension), so — unlike a normal P/Invoke native lib —
       the .NET host does NOT resolve it from the NuGet cache; the file
       must physically sit in the app's output.

       The binaries are packed under buildTransitive/native/<rid>/ rather than
       the idiomatic runtimes/<rid>/native/, because platform SDKs harvest the
       latter: the .NET Android SDK pulled the linux-x64 / linux-arm64 .so files
       into APKs by architecture (see the csproj comment and
       docs/BLAZOR_WASM_MAUI_SQLITE_PLAN.md §13). Consequence: NuGet no longer
       delivers them for us in ANY case, so this file handles both —

         * no RuntimeIdentifier       -> pick the binary matching the build OS;
         * explicit RuntimeIdentifier -> pick that exact RID, if the package ships it.

       Either way the file is copied preserving the runtimes/<rid>/native/ layout
       that SqliteDataSource.LocatePackagedExtension() probes.

       A RID we do not ship (android-arm64, browser-wasm, win-arm64, ...) matches
       nothing and copies nothing — which is exactly what those targets need.
       A fully cross-platform package needs each redbsqlite.{dll,so,dylib} packed
       (CI matrix — see native/README.md).
       =================================================================== -->

  <ItemGroup>
    <!-- Windows x64 -->
    <None Include="$(MSBuildThisFileDirectory)native\win-x64\redbsqlite.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)native\win-x64\redbsqlite.dll') And
                     ('$(RuntimeIdentifier)' == 'win-x64' Or
                      ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))))">
      <Link>runtimes\win-x64\native\redbsqlite.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>

    <!-- Linux x64 -->
    <None Include="$(MSBuildThisFileDirectory)native\linux-x64\redbsqlite.so"
          Condition="Exists('$(MSBuildThisFileDirectory)native\linux-x64\redbsqlite.so') And
                     ('$(RuntimeIdentifier)' == 'linux-x64' Or
                      ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))))">
      <Link>runtimes\linux-x64\native\redbsqlite.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>

    <!-- Linux arm64 — no OS fallback: an arm64 build host is not implied by
         "running on Linux", so it takes an explicit RID. -->
    <None Include="$(MSBuildThisFileDirectory)native\linux-arm64\redbsqlite.so"
          Condition="Exists('$(MSBuildThisFileDirectory)native\linux-arm64\redbsqlite.so') And
                     '$(RuntimeIdentifier)' == 'linux-arm64'">
      <Link>runtimes\linux-arm64\native\redbsqlite.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>

    <!-- macOS x64 -->
    <None Include="$(MSBuildThisFileDirectory)native\osx-x64\redbsqlite.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)native\osx-x64\redbsqlite.dylib') And
                     ('$(RuntimeIdentifier)' == 'osx-x64' Or
                      ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))))">
      <Link>runtimes\osx-x64\native\redbsqlite.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>

    <!-- macOS arm64 — explicit RID, same reasoning as linux-arm64. -->
    <None Include="$(MSBuildThisFileDirectory)native\osx-arm64\redbsqlite.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)native\osx-arm64\redbsqlite.dylib') And
                     '$(RuntimeIdentifier)' == 'osx-arm64'">
      <Link>runtimes\osx-arm64\native\redbsqlite.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
</Project>
